{
  "name": "shopport-be",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "nest build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:publish-workflow && pnpm check:storage-encryption",
    "check:publish-workflow": "node scripts/check-publish-workflow.mjs",
    "check:storage-encryption": "node scripts/check-storage-encryption.mjs",
    "check:schema": "node scripts/check-schema-compatibility.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "dev:worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/src/worker.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.mjs",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-integration.config.mjs --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@aws-sdk/client-s3": "^3.876.0",
    "@aws-sdk/client-sqs": "^3.876.0",
    "@aws-sdk/cloudfront-signer": "^3.876.0",
    "@aws-sdk/s3-request-presigner": "^3.876.0",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "^13.4.4",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/throttler": "^6.4.0",
    "@tanstack/ai": "0.44.0",
    "@tanstack/ai-openai": "0.19.0",
    "dataloader": "^2.2.3",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "nestjs-pino": "^4.4.1",
    "pg": "8.23.0",
    "pino": "^9.9.0",
    "reflect-metadata": "^0.2.2",
    "redis": "6.2.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "uuid": "^13.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.9",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/express": "^5.0.3",
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "testcontainers": "11.5.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jest": "^30.1.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
