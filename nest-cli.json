{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      "schema.graphql",
      {
        "include": "modules/ai/shopping-ai-harness.md",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  },
  "sourceRoot": "src"
}
